#!/usr/bin/env bash
# tmux-worktree-window — open a new tmux window, with worktree selection if available.
#
# Usage (from tmux):
#   bind C run-shell "~/bin/tmux-worktree-window '#{pane_current_path}'"
#
# If the pane is in a git repo with multiple worktrees, a popup lets you pick
# which worktree to open the window in.  Otherwise behaves like new-window -c.

set -eu

if [[ "${1:-}" == "--pick" ]]; then
  pane_path="$2"
  selected=$(git -C "$pane_path" worktree list \
    | fzf --prompt="Worktree › " --reverse --no-info || true)
  if [[ -n "$selected" ]]; then
    wt_path=$(awk '{print $1}' <<< "$selected")
    tmux new-window -c "$wt_path" -n "$(basename "$wt_path")"
  fi
  exit 0
fi

pane_path="${1:?usage: tmux-worktree-window <path>}"

if ! git -C "$pane_path" rev-parse --is-inside-work-tree &>/dev/null; then
  tmux new-window -c "$pane_path"
  exit 0
fi

if [[ $(git -C "$pane_path" worktree list | wc -l) -lt 2 ]]; then
  tmux new-window -c "$pane_path"
  exit 0
fi

escaped_path=$(printf '%q' "$pane_path")
tmux display-popup -E -w 60% -h 40% \
  "$HOME/bin/tmux-worktree-window --pick $escaped_path"
